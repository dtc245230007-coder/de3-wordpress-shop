# =============================================================================
# Sao chép tệp này thành .env rồi đổi TOÀN BỘ giá trị bên dưới.
#   cp .env.example .env
#   chmod 600 .env          # chỉ chủ sở hữu đọc được
# KHÔNG commit .env lên GitHub (đã có trong .gitignore).
# Sinh mật khẩu mạnh:  openssl rand -base64 24
# =============================================================================

# --- MySQL ---------------------------------------------------------------
MYSQL_ROOT_PASSWORD=DoiMatKhauRootManh!
MYSQL_DATABASE=wordpress
MYSQL_USER=wp_app
MYSQL_PASSWORD=DoiMatKhauAppManh!

# Tài khoản chỉ đọc (least privilege – dùng cho báo cáo/BI)
WP_READONLY_USER=wp_readonly
WP_READONLY_PASSWORD=DoiMatKhauReadonly!

# Tài khoản cho Prometheus mysqld_exporter
MYSQL_EXPORTER_USER=exporter
MYSQL_EXPORTER_PASSWORD=DoiMatKhauExporter!

# --- Grafana -------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=DoiMatKhauGrafanaManh!
